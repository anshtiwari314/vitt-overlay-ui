# vitt-overlay-server — copy to .env and adjust:
#   cp .env.example .env

PORT=5000
VITT_CAPTURE_TOKEN=vitt-local-capture-token

# One-shot startup scrape delay (milliseconds). Fires once after server start; restart to run again.
VITT_SCRAPE_START_DELAY_MS=5000

# Enable one scrape type per server start (first enabled wins; restart server to re-run)
req_type_1=false
req_type_2=false
req_type_3=true
req_type_4=false
req_type_5=false

# Optional URL overrides (used by the matching scrape type)
VITT_LISTING_SCRAPE_URL=https://holidayz.makemytrip.com/holidays/india/search?dest=Goa
VITT_PACKAGE_SCRAPE_URL=https://holidayz.makemytrip.com/holidays/india/package?depCity=New%20Delhi&dateSearched=02%2F07%2F2026&dest=Goa&destValue=Goa&glp=true&pdo=true&affiliate=MMT&rooms=2%2C0%2C0%2C0%2C%2C%2C&id=21828&listingClassId=12&depDate=2026-07-02&fromCity=New%20Delhi&variantId=NO_MAJOR_COMMUTE_CCCDEC54&room=2%2C0%2C0%2C0%2C%2C%2C&searchDate=2026-07-02&pkgType=FIT
# Type 4 — close detail tab after scrape (default true; false keeps tab open; Type 3/5 inherit via job JSON)
VITT_TYPE4_CLOSE_DETAIL_TAB=true

# Type 3: set VITT_TYPE4_CLOSE_DETAIL_TAB=false to keep Type 4 detail tab(s) open after scrape

# Type 2 & 3 listing URL (Kerala example)
VITT_TYPE2_LISTING_URL=https://holidayz.makemytrip.com/holidays/india/search?fromSearchWidget=true&searchDep=Kerala&dest=Kerala&destValue=Kerala&depCity=New%20Delhi&initd=searchwidget_landing_Kerala_notheme&dateSearched=03%2F07%2F2026&glp=true&pdo=true&rooms=2%2C0%2C0%2C0%2C%2C%2C&affiliate=MMT##page_header
VITT_TYPE3_LISTING_URL=https://holidayz.makemytrip.com/holidays/india/search?fromSearchWidget=true&searchDep=Kerala&dest=Kerala&destValue=Kerala&depCity=New%20Delhi&initd=searchwidget_landing_Kerala_notheme&dateSearched=03%2F07%2F2026&glp=true&pdo=true&rooms=2%2C0%2C0%2C0%2C%2C%2C&affiliate=MMT##page_header

# Type 5 — listing URL for first-package → Type 4 chain
VITT_TYPE5_LISTING_URL=https://holidayz.makemytrip.com/holidays/india/search?fromSearchWidget=true&searchDep=Kerala&dest=Kerala&destValue=Kerala&depCity=New%20Delhi&initd=searchwidget_landing_Kerala_notheme&dateSearched=03%2F07%2F2026&glp=true&pdo=true&rooms=2%2C0%2C0%2C0%2C%2C%2C&affiliate=MMT##page_header

# Type 3 — package name to search on the listing page
VITT_TYPE3_SEARCH_PACKAGE_NAME=sabarimala SAcred  jOurney
# Type 3 — scrape matched package detail page(s) after search (default true; no listing message sent)
VITT_TYPE3_EXTRACT_PACKAGE_DETAIL=true
# Type 3 — false = keep listing homepage open after package search (default true = close)
VITT_TYPE3_CLOSE_HOME_PAGE_AFTER_SCRAPE=true

# Type 5 — false = keep listing homepage open after first-package scrape (default true = close)
VITT_TYPE5_CLOSE_HOME_PAGE_AFTER_SCRAPE=true

# Type 1 — false = single "All Packages" tab; true = discover #collectionList tabs and scrape each in parallel (default true)
VITT_TYPE1_EXTRACT_ALL_LISTING_TABS=true
# Type 1 — poll every 500ms up to this many ms for #collectionList tabs before scrape/discover
VITT_TYPE1_WAIT_MS=4000
# Type 1 — false = keep first listing homepage tab open after scrape (default true = close)
VITT_TYPE1_CLOSE_HOME_PAGE_AFTER_SCRAPE=true
