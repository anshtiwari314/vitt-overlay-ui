# React client environment variables.
# Copy this file to `.env` and fill in real values:
#   cp .env.example .env
#
# Vite only exposes variables prefixed with VITE_ to the client at build/dev time.
# After editing `.env`, restart the Vite dev server -- HMR does not reload env files.

# Skip the login screen and boot the app as a synthetic "Dev User".
# Set to "false" (or remove) to require real login.

VITE_BYPASS_LOGIN=false

# HTTP origin of the backend server (no trailing slash).
# The WebSocket URL is derived from this automatically:
#   http://  -> ws://...   |   https:// -> wss://...
#   path defaults to /ws if not specified
# Examples:
#   VITE_SERVER_BASE_URL=http://localhost:5000
#   VITE_SERVER_BASE_URL=https://your-tunnel.ngrok-free.app

VITE_SERVER_BASE_URL=http://localhost:5000
