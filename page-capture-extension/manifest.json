{
  "manifest_version": 3,
  "name": "Vitt Page Capture",
  "version": "1.0.0",
  "description": "Server-driven page capture with scroll-until-stable for Vitt Overlay.",
  "permissions": ["tabs", "scripting", "storage", "alarms"],
  "host_permissions": ["http://*/*", "https://*/*", "http://127.0.0.1:38771/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Vitt Page Capture",
    "default_popup": "popup.html"
  },
  "options_page": "options.html"
}
