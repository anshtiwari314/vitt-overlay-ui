{
  "manifest_version": 3,
  "name": "Vitt Page Capture",
  "version": "1.4.4",
  "description": "Manual page capture to vitt-overlay-server plus automated scroll-and-extract via Vitt Overlay.",
  "permissions": ["tabs", "scripting", "storage", "alarms", "activeTab", "offscreen"],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "http://127.0.0.1:5000/*",
    "http://localhost:5000/*",
    "ws://127.0.0.1:38772/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Capture this page",
    "default_popup": "popup.html"
  },
  "options_page": "options.html"
}
