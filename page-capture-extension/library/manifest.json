{
  "manifest_version": 3,
  "name": "MMT Itinerary ID Capture",
  "version": "1.0.0",

  "description": "Captures itinerary ID from MakeMyTrip DIY Planner",

  "permissions": [
    "storage"
  ],

  "host_permissions": [
    "http://127.0.0.1:5000/*"
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "MMT Itinerary ID Capture"
  },

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": [
        "https://holidayz.makemytrip.com/holidays/diyPlanner*"
      ],
      "js": [
        "interceptor.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://holidayz.makemytrip.com/holidays/diyPlanner*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    }
  ]
}
