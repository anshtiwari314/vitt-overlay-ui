# Electron main-process environment variables.
# Copy this file to `.env` and fill in real values:
#   cp .env.example .env
#
# These are loaded by `dotenv` at app startup (see main.js).
# They are NOT exposed to the React renderer; for renderer env vars edit
# ../vitt-overlay-react-client/.env (VITE_-prefixed keys only).

# Recall.ai desktop SDK API endpoint.
# Use the regional endpoint that matches your Recall.ai workspace.
# Examples:
#   https://us-west-2.recall.ai
#   https://us-east-1.recall.ai
#   https://eu-central-1.recall.ai
RECALLAI_API_URL=https://us-west-2.recall.ai

# Recall.ai API token for the desktop SDK. Treat as secret -- do NOT commit.
# Get one from https://www.recall.ai/  > Dashboard > API Keys
RECALLAI_API_KEY=your-recall-api-token-here
